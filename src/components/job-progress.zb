<!--
  Where a job is, live. The job is a Sync document only the server writes ('use collection jobs
  by job'); this browser may read it because it opened the job's link (the server's scope). When
  the shop moves the job along, or the balance is paid, the customer's page follows without a
  reload. `steps` are the kind's stages and `names` how each reads.
-->
<script>
  'use collection jobs by job'
  import { from } from '@zubra/runtime'

  let status = from(statusNow)
  let paid = from(paidNow)

  const reached = steps.indexOf(status)
  const balance = Math.max(0, cents - deposit - paid)
  const money = (amount) => `$${(amount / 100).toFixed(2)}`
</script>
<style>
  :host { display: grid; gap: 0.9rem; }
  ol { display: grid; gap: 0.35rem; margin: 0; padding: 0; list-style: none; counter-reset: step; }
  li { display: flex; align-items: center; gap: 0.6rem; color: var(--muted-foreground, #6b6457); }
  li::before { counter-increment: step; content: counter(step); display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--border, #d8cfbf); font-size: 0.8rem; font-weight: 700; }
  li.done { color: var(--foreground, #2a241b); font-weight: 600; }
  li.done::before { content: "✓"; background: var(--primary, #4a5d23); color: var(--primary-foreground, #fff); box-shadow: none; }
  li.now { font-weight: 800; }
  .ready { margin: 0; padding: 0.8rem 1rem; border-radius: 0.6rem; background: #e3efd2; color: #2c3d10; font-weight: 700; }
  .owed { margin: 0; font-weight: 700; }
  .settled { margin: 0; color: var(--muted-foreground, #6b6457); }
</style>
<job-progress job="" steps={[]} names={{}} status-now="received" paid-now={0} cents={0} deposit={0} pay="">
  <p class="ready" zb-if={status === 'ready'} role="status">Ready for pickup.</p>
  <ol aria-label="Where your job is">
    <zb-each items={steps} as="step" key={step}>
      <li class:done={steps.indexOf(step) <= reached} class:now={step === status} aria-current={step === status ? 'step' : null}>{names[step] ?? step}</li>
    </zb-each>
  </ol>
  <p class="owed" zb-if={balance > 0 && status !== 'picked-up'}>Balance due: {money(balance)} <a zb-if={pay && status === 'ready'} href={pay}>Pay it now</a></p>
  <p class="settled" zb-if={balance === 0}>Paid in full.</p>
</job-progress>
