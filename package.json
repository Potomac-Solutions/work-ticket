{
  "name": "work-ticket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drop off and track: a job tag, stages the customer follows live, a ready text and the balance paid online. A Potomac Solutions platform, built on the kit and Zubra.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node bin/seed.js",
    "demo": "node bin/seed.js --fresh && node server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "design-check": "node scripts/design-check.js"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@journey-to-code/symbology": "0.2.0",
    "@potomac-solutions/kit": "github:Potomac-Solutions/potomac-kit#82fcc28c176cea4b8118e0163efc1d03ef94953e",
    "@zubra/compiler": "^6.0.5",
    "@zubra/runtime": "^6.0.5",
    "@zubra/server": "^6.0.5",
    "@zubra/sync": "^6.0.5"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "26.x"
  }
}
